{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#fbf7ef",
					"name": "Background",
					"slug": "background"
				},
				{
					"color": "#121d18",
					"name": "Ink",
					"slug": "ink"
				},
				{
					"color": "#25483d",
					"name": "Pine",
					"slug": "pine"
				},
				{
					"color": "#bd6f4a",
					"name": "Terracotta",
					"slug": "terracotta"
				},
				{
					"color": "#2d6f88",
					"name": "Coast",
					"slug": "coast"
				},
				{
					"color": "#f2d49b",
					"name": "Sun",
					"slug": "sun"
				},
				{
					"color": "#ffffff",
					"name": "White",
					"slug": "white"
				}
			]
		},
		"custom": {
			"radius": {
				"small": "6px",
				"medium": "8px"
			}
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1180px"
		},
		"spacing": {
			"spacingScale": {
				"operator": "*",
				"increment": 1.5,
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem"
			},
			"units": [
				"px",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"typography": {
			"dropCap": true,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "Fraunces, Georgia, serif",
					"name": "Display",
					"slug": "display"
				},
				{
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"name": "Body",
					"slug": "body"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": false,
					"name": "Base",
					"size": "1rem",
					"slug": "base"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.35rem"
					},
					"name": "Lead",
					"size": "1.25rem",
					"slug": "lead"
				},
				{
					"fluid": {
						"min": "1.75rem",
						"max": "2.6rem"
					},
					"name": "Large",
					"size": "2.2rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "2.6rem",
						"max": "5.8rem"
					},
					"name": "Hero",
					"size": "4.9rem",
					"slug": "hero"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontWeight": "700"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.95rem",
					"fontWeight": "700"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "650",
					"lineHeight": "0.98"
				}
			},
			"core/query-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "650",
					"lineHeight": "1.02"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--ink)"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--pine)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var(--wp--preset--color--terracotta)",
					"text": "var(--wp--preset--color--white)"
				},
				"spacing": {
					"padding": {
						"bottom": ".86rem",
						"left": "1.24rem",
						"right": "1.24rem",
						"top": ".86rem"
					}
				},
				"typography": {
					"fontWeight": "700"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "650",
					"lineHeight": "1.02"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--terracotta)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--pine)"
				}
			}
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 3rem)",
				"right": "clamp(1rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.65"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	],
	"customTemplates": [
		{
			"name": "landing",
			"postTypes": [
				"page"
			],
			"title": "Travel landing page"
		}
	]
}
